{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "cpu",
      "displayName": "CPU (RelWithDebInfo, ccache, Ninja)",
      "description": "The build that matters for Sprint 1. Toolchain comes from the activated spack env.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG",
        "CMAKE_CXX_COMPILER": "mpicxx",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "USE_CUDA": "OFF"
      }
    },
    {
      "name": "cuda",
      "inherits": "cpu",
      "displayName": "CUDA (optional, off by default)",
      "description": "Enable only on a machine with a GPU + CUDA toolkit.",
      "binaryDir": "${sourceDir}/build/cuda",
      "cacheVariables": {
        "USE_CUDA": "ON"
      }
    },
    {
      "name": "cpu-python",
      "inherits": "cpu",
      "displayName": "CPU + Python bindings",
      "description": "The cpu build plus the pybind11 module (needs py-pybind11 in the env).",
      "binaryDir": "${sourceDir}/build/cpu-python",
      "cacheVariables": {
        "INCNS_PYTHON": "ON"
      }
    },
    {
      "name": "cpu-asan",
      "inherits": "cpu",
      "displayName": "CPU + ASan/UBSan",
      "description": "The C++ suite instrumented with AddressSanitizer + UndefinedBehaviorSanitizer (no Python). Run via scripts/asan.sh.",
      "binaryDir": "${sourceDir}/build/cpu-asan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g -DNDEBUG",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "cpu", "configurePreset": "cpu" },
    { "name": "cuda", "configurePreset": "cuda" },
    { "name": "cpu-python", "configurePreset": "cpu-python" },
    { "name": "cpu-asan", "configurePreset": "cpu-asan" }
  ],
  "testPresets": [
    {
      "name": "cpu",
      "configurePreset": "cpu",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "cpu-python",
      "configurePreset": "cpu-python",
      "output": { "outputOnFailure": true }
    }
  ]
}
