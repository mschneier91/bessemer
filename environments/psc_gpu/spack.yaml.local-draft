spack:
  specs:
    - mfem@develop+gslib+lapack+libceed+mpi+shared+static+suite-sparse+cuda
      ^gslib@1.0.9 cflags="-fPIC"
      ^hypre+cuda
      ^openmpi+cuda
      ^suite-sparse~cuda

    - cmake
    - ninja

    - googletest
    - astyle
    - yaml-cpp

    # Python interface: our own pybind11 bindings over the incns Case surface
    # (PyMFEM is never used). numba provides the @cfunc fast path for
    # user-defined ICs/BCs/forcing -- a raw C function pointer the bindings wrap
    # as an mfem::Coefficient, avoiding per-quad-point Python-callback overhead.
    # No mpi4py: Python is a pure SPMD driver; MPI lives below the binding line.
    # numba lags Python releases, so the interpreter is pinned to a
    # numba-supported version, and numba likewise constrains the numpy version.
    - python@3.12
    - py-pybind11
    - py-numpy
    - py-numba

  packages:
    all:
      providers:
        mpi: [openmpi]

  concretizer:
    unify: true

  view: true