# Throughput benchmark: turbulent channel at Re_tau 178.12 (the physics of
# benchmarks/channel/channel_retau180.yaml: 24 x 18 x 24 Q3/Q2 elements, tanh
# wall clustering, OIFS BDF3, constant pressure gradient), replayed from its
# frozen restart at t = 60 (runs/bench/cases/chan180_t60/chk) at the
# checkpoint's next step, fixed. Use with bench.py --restart ... --sizes 24
# (the size is fixed by the restart; {N} is not used). Generated by
# bench/throughput/bench.py; placeholders in braces.
equation: navier_stokes

physics:
  nu: 5.61419267909e-3

discretization:
  order_u: 3
  order_p: 2
{EXTRA_DISC}

mesh:
  dim: 3
  elements: [24, 18, 24]
  lengths: [6.283185307179586, 2.0, 3.141592653589793]
  periodic: [true, false, true]
  stretch: [none, tanh, none]
  stretch_beta: [1.0, 3.0, 1.0]

initial_velocity: channel

forcing:
  body_force: [1.0, 0.0, 0.0]

time:
  dt: {DT}
  t_final: {TFINAL}
  step_control: fixed
  convection: oifs
{EXTRA_TIME}

boundary_conditions:
  - {select: [ymin, ymax], type: no_slip}

output:
  path: {PATH}
  name: chan
  diagnostics: true
  interval: 1
  history: true
  profile: {PROFILE}
{EXTRA}
