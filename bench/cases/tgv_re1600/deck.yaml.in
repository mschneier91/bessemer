# Throughput benchmark: Taylor-Green Re 1600 (the physics of
# benchmarks/tgv_re1600), {N}^3 Q3/Q2 elements, FIXED steps so that every
# change does the same work per step: dt = 0.5 / N, CFL ~0.29 at t = 0
# (Nek's definition), {STEPS} steps from t = 0. Generated by
# bench/throughput/bench.py; placeholders in braces.
equation: navier_stokes

physics:
  nu: 6.25e-4

discretization:
  order_u: 3
  order_p: 2
{EXTRA_DISC}

mesh:
  dim: 3
  elements: [{N}, {N}, {N}]
  lengths: [6.283185307179586, 6.283185307179586, 6.283185307179586]
  periodic: [true, true, true]

initial_velocity: taylor_green_3d

time:
  dt: {DT}
  t_final: {TFINAL}
  step_control: fixed
  convection: imex
{EXTRA_TIME}
output:
  path: {PATH}
  name: tgv
  diagnostics: true
  interval: 1
  history: true
  profile: {PROFILE}
{EXTRA}